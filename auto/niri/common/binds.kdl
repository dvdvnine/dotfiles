binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }

    // Connects to the running 'Ghostty' instance via D-Bus.
    Mod+Return hotkey-overlay-title="Open a terminal" { spawn-sh "ghostty +new-window"; }
    Mod+E hotkey-overlay-title="Open a file manager" { spawn-sh "nautilus --new-window"; }

    Mod+Space hotkey-overlay-title="Toggle a launcher" { spawn-sh "noctalia msg panel-toggle launcher"; }

    Mod+Comma hotkey-overlay-title="Toggle Noctalia settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+Escape hotkey-overlay-title="Toggle session menu" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+S hotkey-overlay-title="Toggle control center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+A hotkey-overlay-title="Toggle audio menu" { spawn-sh "noctalia msg panel-toggle control-center audio"; }
    Mod+N hotkey-overlay-title="Toggle notification menu" { spawn-sh "noctalia msg panel-toggle control-center notifications"; }

    Mod+Ctrl+N hotkey-overlay-title="Clear notification history" { spawn-sh "noctalia msg notification-clear-history"; }

    Mod+W repeat=false { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Ctrl+F { maximize-column; }
    Mod+T { toggle-window-floating; }
    Mod+C { center-column; }
    Mod+O { toggle-overview; }

    Mod+V { switch-focus-between-floating-and-tiling; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // `<shift>` usually scrolls horizontally, but it's inconvenient here.
    Mod+WheelScrollDown { focus-column-left-or-last; }
    Mod+WheelScrollUp { focus-column-right-or-first; }

    Mod+U repeat=false { focus-workspace-up; }
    Mod+D repeat=false { focus-workspace-down; }

    // Keep in mind that 'Niri' is a dynamic workspace system.
    Mod+1 repeat=false { focus-workspace "first"; }
    Mod+2 repeat=false { focus-workspace "second"; }
    Mod+Tab repeat=false { focus-workspace "scratchpad"; }
    Mod+P repeat=false { focus-workspace "_"; }

    Mod+Shift+1 { move-column-to-workspace "first"; }
    Mod+Shift+2 { move-column-to-workspace "second"; }
    Mod+Shift+Tab { move-column-to-workspace "scratchpad"; }
    Mod+Shift+P { move-column-to-workspace "_"; }

    // These binds will change direction based on the natural-scroll setting.
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    Mod+Shift+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Ctrl+H { consume-or-expel-window-left; }
    Mod+Ctrl+L { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Print { screenshot; }
    Ctrl+Print { screenshot-window; }
    Alt+Print { screenshot-screen; }

    // Applications such as remote-desktop clients and software KVM switches may
    // request that niri stops processing the keyboard shortcuts defined here
    // so they may, for example, forward the key presses as-is to a remote machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor,
    // so a buggy application can't hold your session hostage.
    //
    // The `allow-inhibiting=false` property can be applied to other binds as well,
    // which ensures 'Niri' always processes them, even when an inhibitor is active.
    Mod+Shift+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // The `quit` action will show a confirmation dialog to avoid accidental exits.
    Ctrl+Alt+Delete { quit; }
}
