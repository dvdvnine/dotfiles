workspace "_" {
  layout {
      default-column-width {};
      struts { bottom 160; }
  }
}
workspace "scratchpad"
workspace "first"
workspace "second"

input {
    mod-key "Super"

    keyboard {
        xkb {
            layout "us,ru"
            options "grp:caps_toggle,compose:ralt"
        }

        track-layout "window"
        repeat-delay 240
    }

    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 1000
}

layout {
    gaps 16

    struts {
        right 8
        left 8
        top 8
        bottom 8
    }

    center-focused-column "never"
    always-center-single-column

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 20
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    tab-indicator{
      gap 8
      length total-proportion=0.3
      active-color "#c9b03e"
      inactive-color "#505050"
      urgent-color "#9b0000"
    }

    background-color "#000000"
    insert-hint { off; }
}

blur {
    off
    passes 2
    offset 3
    noise 0.05
    saturation 1.5
}

overview { backdrop-color "#000000"; }

recent-windows { off; }

// Allows notification actions and window activation from Noctalia.
debug { honor-xdg-activation-with-invalid-serial; }

screenshot-path null

window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    tiled-state true
}
