window-rule {
    match is-window-cast-target=true

    shadow {
        on
        softness 20
        spread 2
        color "#c9b03e"
    }
}

window-rule {
    match app-id="KeePassXC"

    block-out-from "screen-capture"
}

window-rule {
    match app-id="org.telegram.desktop"
    match app-id="org.qbittorrent.qBittorrent"
    match app-id="org.nicotine_plus.Nicotine"
    match app-id=".*[.]exe$"
    match app-id="^steam_proton$"
    exclude is-window-cast-target=true

    block-out-from "screencast"
}

layer-rule {
    match namespace="noctalia-notifications"

    block-out-from "screencast"
}
